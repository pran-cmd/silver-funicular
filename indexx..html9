<style>
@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800;900&display=swap');

:root {
    --black: #080808;
    --dark: #111111;
    --gold: #d4af37;
    --white: #ffffff;
    --gray: #aaaaaa;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    background: var(--black);
    color: var(--white);
    font-family: 'Montserrat', Arial, sans-serif;
}

/* HEADER */

.header {
    min-height: 85px;
    padding: 20px 7%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #050505;
    border-bottom: 1px solid #292929;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 24px;
    font-weight: 900;
    letter-spacing: 1px;
}

.logo span {
    color: var(--gold);
}

nav {
    display: flex;
    gap: 25px;
}

nav a,
.footer-links a {
    color: white;
    text-decoration: none;
    font-size: 12px;
    transition: 0.3s;
}

nav a:hover,
.footer-links a:hover {
    color: var(--gold);
}

.header-right {
    color: var(--gold);
    font-size: 11px;
    font-weight: bold;
}

.live-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: #e53935;
    border-radius: 50%;
    margin-right: 5px;
}

.menu-btn {
    display: none;
    background: transparent;
    color: var(--gold);
    border: none;
    font-size: 26px;
}

/* BREAKING NEWS */

.breaking {
    display: flex;
    align-items: center;
    background: var(--gold);
    color: black;
    padding: 12px 7%;
    font-size: 12px;
    font-weight: bold;
}

.breaking strong {
    white-space: nowrap;
    margin-right: 20px;
}

/* HERO */

.hero {
    min-height: 550px;
    display: flex;
    align-items: center;
    padding: 70px 10%;
    background:
        linear-gradient(90deg, #000000 5%, #000000c9 45%, #00000040),
        url("https://images.unsplash.com/photo-1497366754035-f200968a6e72?w=1600")
        center/cover;
}

.hero-content {
    max-width: 650px;
}

.tag,
.small-title {
    color: var(--gold);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 3px;
}

.hero h1 {
    font-size: clamp(42px, 7vw, 76px);
    font-weight: 900;
    line-height: 1.08;
    margin: 25px 0;
}

.hero p {
    color: #cccccc;
    line-height: 1.8;
    max-width: 450px;
    margin-bottom: 30px;
}

.gold-btn {
    display: inline-block;
    background: var(--gold);
    color: black;
    padding: 15px 25px;
    text-decoration: none;
    font-size: 12px;
    font-weight: 800;
    transition: 0.3s;
}

.gold-btn:hover {
    background: white;
    transform: translateY(-3px);
}

/* NEWS SECTION */

.section {
    padding: 85px 7%;
}

.section-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    margin-bottom: 35px;
}

.section-heading h2,
.newsletter h2 {
    font-size: 35px;
    margin-top: 12px;
}

#search {
    padding: 13px 18px;
    background: #171717;
    color: white;
    border: 1px solid #444;
    border-radius: 5px;
    outline: none;
}

#search:focus {
    border-color: var(--gold);
}

.categories {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 35px;
}

.categories button {
    background: #171717;
    border: 1px solid #333;
    color: white;
    padding: 11px 18px;
    cursor: pointer;
    border-radius: 4px;
    transition: 0.3s;
}

.categories button:hover,
.categories button.active {
    background: var(--gold);
    color: black;
    border-color: var(--gold);
}

.news-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
}

.news-card {
    background: #121212;
    border: 1px solid #252525;
    transition: 0.3s;
    overflow: hidden;
}

.news-card:hover {
    transform: translateY(-7px);
    border-color: var(--gold);
}

.news-card img {
    width: 100%;
    height: 210px;
    object-fit: cover;
}

.card-content {
    padding: 24px;
}

.category {
    color: var(--gold);
    font-size: 10px;
    font-weight: bold;
    letter-spacing: 2px;
}

.card-content h3 {
    font-size: 17px;
    line-height: 1.5;
    margin: 15px 0;
}

.card-content p {
    color: var(--gray);
    font-size: 12px;
    line-height: 1.8;
    margin-bottom: 20px;
}

.read-more {
    color: var(--gold);
    font-size: 11px;
    font-weight: bold;
    text-decoration: none;
}

#noResults {
    display: none;
    color: var(--gray);
    text-align: center;
    padding: 30px;
}

/* NEWSLETTER */

.newsletter {
    text-align: center;
    padding: 85px 20px;
    background: #151515;
    border-top: 1px solid #333;
    border-bottom: 1px solid #333;
}

.newsletter p {
    color: var(--gray);
    margin: 15px 0 25px;
    font-size: 13px;
}

.newsletter form {
    display: flex;
    justify-content: center;
    gap: 10px;
    max-width: 550px;
    margin: auto;
}

.newsletter input {
    flex: 1;
    min-width: 0;
    padding: 15px;
    background: black;
    border: 1px solid #444;
    color: white;
}

.newsletter button {
    background: var(--gold);
    border: none;
    padding: 15px 20px;
    font-weight: bold;
    cursor: pointer;
}

/* FOOTER */

footer {
    padding: 50px 20px;
    text-align: center;
    background: #050505;
}

footer p {
    color: var(--gray);
    margin-top: 15px;
    font-size: 12px;
}

.footer-links {
    display: flex;
    justify-content: center;
    gap: 25px;
    margin: 30px 0;
    flex-wrap: wrap;
}

.copyright {
    border-top: 1px solid #292929;
    padding-top: 25px;
}

/* MOBILE RESPONSIVE */

@media (max-width: 850px) {

    .header {
        flex-wrap: wrap;
    }

    .menu-btn {
        display: block;
    }

    nav {
        display: none;
        flex-direction: column;
        width: 100%;
        padding: 20px 0;
    }

    nav.show {
        display: flex;
    }

    .header-right {
        display: none;
    }

    .news-grid {
        grid-template-columns: repeat(2, 1fr);
    }
}

@media (max-width: 600px) {

    .hero {
        min-height: 470px;
        padding: 50px 7%;
    }

    .section {
        padding: 60px 5%;
    }

    .section-heading {
        flex-direction: column;
        align-items: flex-start;
    }

    #search {
        width: 100%;
    }

    .news-grid {
        grid-template-columns: 1fr;
    }

    .newsletter form {
        flex-direction: column;
    }

    .newsletter button {
        width: 100%;
    }
}
</style>